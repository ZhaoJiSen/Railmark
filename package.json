{
  "name": "railmark",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "go tool mygo dev",
    "dev:web": "next dev --hostname 127.0.0.1 --port 3419",
    "build": "go tool mygo build -platform darwin/arm64",
    "build:web": "next build",
    "generate": "go tool mygo generate",
    "typecheck": "tsc --noEmit",
    "ci": "npm run check:source && npm run typecheck && go test ./...",
    "check:source": "node scripts/check-source-length.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.21.0",
    "motion": "^14.14.0",
    "mygo-runtime": "0.9.1",
    "next": "16.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-diff-view": "3.3.3",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.23.0",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "sass": "^1.98.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.5",
    "typescript": "^6.0.0"
  }
