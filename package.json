{
  "name": "railmark",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "go tool mygo dev",
    "dev:web": "next dev --hostname 127.0.0.1 --port 3419",
    "build": "go tool mygo build -platform darwin/arm64",
    "build:web": "next build",
    "generate": "go tool mygo generate && go tool mygo generate -o lib/mygo-automation.ts",
    "typecheck": "tsc --noEmit",
    "ci": "npm run check:source && npm run typecheck && go test ./...",
    "check:source": "node scripts/check-source-length.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@heroui/react": "^3.2.7",
    "@heroui/styles": "^3.2.7",
    "@internationalized/date": "^3.12.4",
    "@radix-ui/react-slot": "^1.5.0",
    "@react-aria/utils": "^3.34.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.21.0",
    "motion": "^14.14.0",
    "mygo-runtime": "0.9.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-diff-view": "3.3.3",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.23.0",
    "tailwind-merge": "^3.4.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "sass": "^1.98.0",
    "tailwindcss": "4.3.5",
    "typescript": "^6.0.0"
  }
}
